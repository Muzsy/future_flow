# Server-only template. Use a protected file outside the Git checkout.
# Auth invitation/recovery mail is sent by hosted Supabase, not this application.
# Configure its Custom SMTP separately; see supabase-smtp.env.example and setup docs.
PUBLIC_HOST=alterward.com
# Enable before closed production serving, after configuring Access at Cloudflare.
# This gate is independent of the paid beta window. Local/isolated defaults stay off.
CLOSED_SITE_ENABLED=false
# Hostname only, e.g. your-team.cloudflareaccess.com; application AUD is 64 lowercase hex.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# One operator and at most ten testers. Keep synchronized with Access Allow policy.
# Removing an email requires restarting both web and API to reject its old JWTs.
CLOSED_SITE_ALLOWED_EMAILS=
CLOSED_BETA_ENABLED=false
# Server-only comma-separated Supabase Auth UUIDs, at most ten. Never NEXT_PUBLIC.
CLOSED_BETA_USER_IDS=
ALTERWARD_TAG=beta
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-key
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_SSL_CA_HOST_FILE=/etc/alterward/supabase-ca.crt
OPENAI_API_KEY=your-server-only-key
AI_EVENT_MODEL=gpt-6.1-sol
AI_STORY_MODEL=gpt-6.1-sol
AI_CHECK_MODEL=gpt-6.1-sol
GENERATION_DAILY_LIMIT=3
# Keep disabled until a separate production AI allowance is agreed.
AI_PROJECT_BUDGET_USD=0
# A positive production budget requires an explicitly approved fixed UTC period.
# Use YYYY-MM-DDTHH:mm:ssZ dates. The end is exclusive; there is no automatic renewal.
AI_BUDGET_WINDOW_REQUIRED=true
AI_BUDGET_WINDOW_START=
AI_BUDGET_WINDOW_END=
# Narrative pipeline stays legacy until a separately approved N09 rollout names an explicit cohort.
NARRATIVE_PIPELINE_MODE=legacy
NARRATIVE_FICTION_GENERATION=v8
NARRATIVE_COHORT_USER_IDS=
# Creative narrative jobs only: provider deadline (1000-300000 ms) and fully priced request envelope (100000-196608 bytes).
AI_FICTION_TIMEOUT_MS=180000
AI_FICTION_MAX_REQUEST_BYTES=100000
# Separate operator-side Claude audit allowance; same period and user cap, no automatic retry.
# Use the server-only ANTHROPIC_API_KEY only in the protected audit process.
CLAUDE_PRODUCTION_BUDGET_USD=0
PUBLIC_REVIEW_JOBS_ENABLED=false
PUBLIC_CONTENT_REVIEW_JOBS_ENABLED=false
PUBLIC_CONTENT_CURATION_ENABLED=false
PUBLIC_REVIEW_DAILY_LIMIT=5
PUBLIC_CURATION_ENABLED=false
SCENARIO_VERSIONS_ENABLED=false
SCENARIO_RELEASE_OPERATOR_ENABLED=false
OFFICIAL_LIFE_OPERATOR_ENABLED=false
OFFICIAL_PUBLICATIONS_ENABLED=false
DISCOVERY_ENABLED=false
SAVED_LIVES_ENABLED=false
PUBLIC_REPORTS_ENABLED=false
PUBLIC_METRICS_ENABLED=false
PUBLIC_COLLECTIONS_ENABLED=false
PUBLIC_COLLECTION_OPERATOR_ENABLED=false
PUBLIC_EXTERNAL_EXPOSURE_ENABLED=false
PUBLICATION_REFRESH_ENABLED=false
PUBLIC_FORK_PERMISSION_ENABLED=false
PUBLIC_FORK_STARTS_ENABLED=false
PUBLIC_FORK_OPERATOR_ENABLED=false
PUBLIC_SCENARIOS_ENABLED=false
SCENARIO_PERSONALIZATION_ENABLED=false
SCENARIO_PUBLICATION_OPERATOR_ENABLED=false
PUBLIC_EXPOSURE_OPERATOR_ENABLED=false
PUBLIC_REPORT_OPERATOR_ENABLED=false
PUBLIC_FORK_CHECKPOINTS_ENABLED=false
PUBLIC_CONTENT_BUNDLES_ENABLED=false
PUBLICATIONS_ENABLED=false
PUBLICATION_LINK_SECRET=
AI_USER_BUDGET_USD=0
# Shared remains off until the S3 personal integration and privacy gates pass.
SHARED_CONTEXTS_ENABLED=false
SHARED_FRIEND_ENABLED=false
SHARED_CONNECTED_ENABLED=false
SHARED_WORLD_ENABLED=false
SHARED_INVITE_SIGNING_KEY=
SHARED_DECISION_DEADLINE_SECONDS=
SHARED_GENERATION_DAILY_LIMIT=3
SHARED_GENERATION_CONCURRENT_LIMIT=1
