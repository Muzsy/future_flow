# Operator-only source for HOSTED Supabase Auth > Custom SMTP.
# This file is NOT loaded by Alterward, Compose, or hosted Supabase automatically.
# Store its real copy outside Git with owner-only read/write permissions.
# The operator already stored dedicated credentials only in SMTP2GO and Supabase.
# No extra VPS/local password copy is required. This blank file is an optional reference.
# An API key is not interchangeable with SMTP credentials.
AUTH_SMTP_HOST=mail-eu.smtp2go.com
AUTH_SMTP_PORT=587
# STARTTLS must be verified; this metadata is not an application TLS switch.
AUTH_SMTP_TRANSPORT=starttls
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SENDER_EMAIL=info@alterward.com
AUTH_SMTP_SENDER_NAME=Alterward
# No separate Reply-To: replies use the info@ sender. Verify the actual return delivery.
# mail-eu accepts EU/UK. SMTP2GO documents mail-eu2.smtp2go.com for EU-only ingress.
# Do not enable click/open tracking for authentication email links.
