# Alterward production proxy (plan 055): the same rules as the old shared Caddy
# block, plus the image registry.
#
# alterward.com and www: Cloudflare Origin CA certificate, only Cloudflare peers,
# client address taken from Cf-Connecting-Ip only after that check.
# registry.alterward.com: DNS-only (not proxied by Cloudflare, whose request
# size limit breaks image uploads), a public ACME certificate, and HTTP basic
# authentication with the CI upload credential only.

(cloudflare-only) {
	# Cloudflare IPv4/IPv6 ranges (https://www.cloudflare.com/ips-v4, -v6),
	# checked 2026-10-09; refresh before activation.
	@outside_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @outside_cloudflare "Origin access denied." 403
}

alterward.com {
	tls /origin/origin.crt /origin/origin.key
	route {
		import cloudflare-only
		encode zstd gzip
		handle /api/* {
			@missing_client_ip not header Cf-Connecting-Ip *
			respond @missing_client_ip "Client address unavailable." 400
			reverse_proxy alterward-api:4000 {
				header_up X-Forwarded-For {http.request.header.Cf-Connecting-Ip}
			}
		}
		handle {
			reverse_proxy alterward-web:3000
		}
	}
}

www.alterward.com {
	tls /origin/origin.crt /origin/origin.key
	route {
		import cloudflare-only
		redir https://alterward.com{uri} 308
	}
}

registry.alterward.com {
	request_body {
		max_size 4GB
	}
	basic_auth {
		{$REGISTRY_UPLOAD_USER} {$REGISTRY_UPLOAD_HASH}
	}
	reverse_proxy registry:5000
}
