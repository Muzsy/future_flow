{
  "name": "alterward",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently -k -n web,api,worker \"pnpm --filter @future-flow/web dev\" \"pnpm --filter @future-flow/api dev\" \"pnpm --filter @future-flow/worker dev\"",
    "build:packages": "pnpm --filter @future-flow/contracts build && pnpm --filter @future-flow/core build && pnpm --filter @future-flow/database build && pnpm --filter @future-flow/ai build",
    "build": "pnpm build:packages && pnpm --filter @future-flow/api build && pnpm --filter @future-flow/worker build && pnpm --filter @future-flow/web build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "test": "pnpm build:packages && vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "verify:infra": "tsx --env-file-if-exists=.env scripts/verify-infrastructure.ts",
    "privacy:recover": "tsx --env-file-if-exists=.env scripts/recover-account-deletion.ts",
    "metrics:private": "tsx --env-file-if-exists=.env scripts/private-metrics.ts",
    "feedback:report": "tsx --env-file-if-exists=.env scripts/feedback-report.ts",
    "moderation:shared": "tsx --env-file-if-exists=.env scripts/shared-moderation.ts",
    "curation:public": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/public-curation.ts",
    "curation:public:content": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/public-content-curation.ts",
    "moderation:publication": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/publication-moderation.ts",
    "moderation:official-publication": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/official-publication-moderation.ts",
    "moderation:public-report": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/public-report-moderation.ts",
    "release:scenario": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/scenario-release.ts",
    "release:official-life": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/official-life.ts",
    "review:public": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/review-public-draft.ts",
    "smoke:public:review": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/smoke-public-review.ts",
    "smoke:public:content-review": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/smoke-public-content-review.ts",
    "smoke:ai": "tsx --env-file-if-exists=.env scripts/smoke-ai.ts",
    "smoke:life": "tsx --env-file-if-exists=.env scripts/smoke-life.ts",
    "smoke:shared": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/smoke-shared-ai.ts",
    "smoke:shared:personal": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/smoke-shared-personal-ai.ts",
    "audit:shared:claude": "pnpm build:packages && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/audit-shared-personal-claude.ts",
    "smoke:auth": "pnpm build:packages && pnpm --filter @future-flow/api build && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/smoke-authenticated-life.ts",
    "smoke:shared:auth": "pnpm build:packages && pnpm --filter @future-flow/api build && tsx --tsconfig tsconfig.scripts.json --env-file-if-exists=.env scripts/smoke-shared-authenticated.ts",
    "evaluate:claude": "tsx --env-file-if-exists=.env scripts/evaluate-claude.ts",
    "schemas": "pnpm --filter @future-flow/contracts schemas",
    "format": "prettier --write apps packages scripts tests deploy \"*.json\" \"*.ts\" \"*.yaml\" .github",
    "format:check": "prettier --check apps packages scripts tests deploy \"*.json\" \"*.ts\" \"*.yaml\" .github",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@future-flow/ai": "workspace:*",
    "@future-flow/contracts": "workspace:*",
    "@future-flow/core": "workspace:*",
    "@future-flow/database": "workspace:*",
    "@supabase/supabase-js": "2.117.2",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "openai": "7.25.0",
    "prettier": "3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "4.6.5"
  }
}
