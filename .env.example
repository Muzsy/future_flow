# Másold .env fájlba a repó gyökerében. Titkokat ne commitolj.
DATABASE_URL=postgresql://postgres:password@localhost:5432/future_flow
DATABASE_SSL=false
DATABASE_SSL_CA_FILE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Separate Claude evaluation allowance, total across all runs; never above 5 USD.
# Claude evaluation uses synthetic fixtures only, not the production worker.
CLAUDE_EXPERIMENT_BUDGET_USD=5
# Structured Outputs-képes modell; az értéket a saját API-hozzáférésedhez válaszd.
AI_EVENT_MODEL=gpt-6.1-sol
AI_STORY_MODEL=gpt-6.1-sol
AI_CHECK_MODEL=gpt-6.1-sol
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=12000
API_PORT=4000
API_HOST=127.0.0.1
API_TRUST_PROXY=0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WORKER_POLL_MS=2000
JOB_LEASE_SECONDS=180
GENERATION_DAILY_LIMIT=10
GENERATION_CONCURRENT_LIMIT=2
# A helyi smoke:ai próbák összesített kerete, USD (legfeljebb 5).
SMOKE_BUDGET_USD=1
# Zero disables spending even with an existing database allowance.
# Positive values bootstrap new accounts; existing stored limits are not raised.
# USD totals include reservations; unknown provider usage keeps its full reservation.
AI_PROJECT_BUDGET_USD=0
AI_USER_BUDGET_USD=0
AI_PROJECT_INITIAL_SPENT_USD=0
# Local experiments only: absolute path to the shared .local/ai-smoke/usage.json.
# Leave blank for production. Shares the lock and total 5 USD smoke allowance.
AI_EXPERIMENT_LEDGER_PATH=
# Paid private-copy reviews: one attempt/preview, one pending job/user, rolling 24h quota.
# Requires positive shared AI project/user allowances on BOTH API and worker.
PUBLIC_REVIEW_JOBS_ENABLED=false
PUBLIC_CONTENT_REVIEW_JOBS_ENABLED=false
PUBLIC_CONTENT_CURATION_ENABLED=false
# PUBLIC_CONTENT_CURATION_OPERATOR_ENABLED=true only for the explicitly invoked local CLI.
PUBLIC_REVIEW_DAILY_LIMIT=5
# Separate owner-submitted copy text review. No publication or Official authority.
PUBLIC_CURATION_ENABLED=false
SCENARIO_VERSIONS_ENABLED=false
# Explicitly invoked local/operator CLI only; no paid HTTP endpoint.
SCENARIO_RELEASE_OPERATOR_ENABLED=false
OFFICIAL_LIFE_OPERATOR_ENABLED=false
OFFICIAL_PUBLICATIONS_ENABLED=false
DISCOVERY_ENABLED=false
SAVED_LIVES_ENABLED=false
PUBLIC_REPORTS_ENABLED=false
PUBLIC_METRICS_ENABLED=false
PUBLIC_COLLECTIONS_ENABLED=false
PUBLIC_COLLECTION_OPERATOR_ENABLED=false
PUBLIC_EXTERNAL_EXPOSURE_ENABLED=false
PUBLICATION_REFRESH_ENABLED=false
PUBLIC_EXPOSURE_OPERATOR_ENABLED=false
# Server-only metadata origin and API base; no request Host or browser credentials.
PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000/api/public
PUBLIC_REPORT_OPERATOR_ENABLED=false
PUBLIC_FORK_CHECKPOINTS_ENABLED=false
PUBLIC_CONTENT_BUNDLES_ENABLED=false
PUBLICATIONS_ENABLED=false
# Independent server-only 32-byte secret (64 lowercase hex); required when enabled.
# Unlisted links use fragments and Authorization headers. Never a NEXT_PUBLIC secret.
PUBLICATION_LINK_SECRET=
# PUBLICATION_OPERATOR_ENABLED=true only for explicitly invoked moderation CLI.
# PUBLIC_CURATION_OPERATOR_ENABLED=true is only for an explicitly invoked local CLI.
# Shared foundation stays disabled until real shared AI/personal integration are complete.
SHARED_CONTEXTS_ENABLED=false
SHARED_FRIEND_ENABLED=false
SHARED_CONNECTED_ENABLED=false
SHARED_WORLD_ENABLED=false
# Separate 32-byte secret encoded as 64 lowercase hex characters; server-side only.
# Required to issue invitations. Never reuse an AI/Auth key or commit this value.
SHARED_INVITE_SIGNING_KEY=
# Shared-only initiating-user quotas; these do not grant AI spending allowance.
SHARED_GENERATION_DAILY_LIMIT=3
SHARED_GENERATION_CONCURRENT_LIMIT=1
# Empty waits for every response. Set 60–604800 for an explicit deadline.
# 172800 (48 hours) is a proposed release setting, still to be agreed.
SHARED_DECISION_DEADLINE_SECONDS=
