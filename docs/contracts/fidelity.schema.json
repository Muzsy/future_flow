{
  "$id": "urn:future-flow:fidelity:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "issues": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapterNo": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          }
        },
        "required": [
          "chapterNo",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "valid",
    "issues"
  ],
  "additionalProperties": false
}
