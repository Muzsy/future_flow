      "type": "string",
      "const": "public-origin-metrics-1"
    },
    "windowDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "fromDay": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "throughDay": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "scope": {
      "type": "string",
      "const": "surviving_active_owner_lives_original_branch"
    },
    "cohorts": {
      "maxItems": 270,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "channel": {
            "type": "string",
            "enum": [
              "official_public_checkpoint",
              "community_public_checkpoint",
              "official_personal_scenario"
            ]
          },
          "createdLives": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "firstPeriodCompletedLives": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "secondPeriodCompletedLives": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "thirdPeriodCompletedLives": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "day",
          "channel",
          "createdLives",
          "firstPeriodCompletedLives",
          "secondPeriodCompletedLives",
          "thirdPeriodCompletedLives"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "windowDays",
    "fromDay",
    "throughDay",
    "scope",
    "cohorts"
  ],
  "additionalProperties": false
}
