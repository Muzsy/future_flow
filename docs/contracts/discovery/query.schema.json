{
  "$id": "urn:alterward:discovery:query:discovery-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "q": {
      "default": "",
      "type": "string",
      "maxLength": 80
    },
    "locale": {
      "default": "en",
      "type": "string",
      "const": "en"
    },
    "category": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "career",
            "business",
            "money",
            "relationships",
            "family",
            "education",
            "lifestyle",
            "moving_abroad",
            "starting_over",
            "personal_growth",
            "adventure",
            "historical",
            "fictional"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "official",
        "community"
      ]
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "pageSize": {
      "default": 12,
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    }
  },
  "required": [
    "q",
    "locale",
    "category",
    "classification",
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
