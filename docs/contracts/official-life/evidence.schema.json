{
  "$id": "urn:alterward:official-life:evidence:official-life-source-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceVersion": {
      "type": "string",
      "const": "official-life-source-1"
    },
    "lifeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "branchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "scenarioVersionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "scenarioGrantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "templateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "initialInputHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "choicesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "properties": {
        "bundleId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reviewHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyVersion": {
          "type": "string",
          "const": "public-content-review-1"
        },
        "curationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "curationVersion": {
          "type": "string",
          "const": "public-content-curation-1"
        }
      },
      "required": [
        "bundleId",
        "contentHash",
        "sourceRevision",
        "reviewId",
        "reviewHash",
        "policyVersion",
        "curationId",
        "curationVersion"
      ],
      "additionalProperties": false
    },
    "periods": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "periodId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "jobId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "position": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "canonHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "chapterHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generation": {
            "type": "object",
            "properties": {
              "sourceHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "periodInputHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "chapterInputHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "fidelityInputHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "sourceHash",
              "periodInputHash",
              "chapterInputHash",
              "fidelityInputHash"
            ],
            "additionalProperties": false
          },
          "receipts": {
            "minItems": 3,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string",
                  "enum": [
                    "life_period",
                    "life_chapter",
                    "life_fidelity",
                    "public_content_review"
                  ]
                },
                "promptVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "locale": {
                  "type": "string",
                  "const": "en"
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "requestId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "inputHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "outputHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "inputTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "outputTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "cachedInputTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cacheWriteTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "reasoningTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "latencyMs": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "task",
                "promptVersion",
                "locale",
                "model",
                "requestId",
                "inputHash",
                "outputHash",
                "inputTokens",
                "outputTokens",
                "latencyMs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "periodId",
          "jobId",
          "position",
          "canonHash",
          "chapterHash",
          "generation",
          "receipts"
        ],
        "additionalProperties": false
      }
    },
    "reviewReceipt": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "enum": [
            "life_period",
            "life_chapter",
            "life_fidelity",
            "public_content_review"
          ]
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "locale": {
          "type": "string",
          "const": "en"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "cachedInputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheWriteTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasoningTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "task",
        "promptVersion",
        "locale",
        "model",
        "requestId",
        "inputHash",
        "outputHash",
        "inputTokens",
        "outputTokens",
        "latencyMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sourceVersion",
    "lifeId",
    "branchId",
    "scenarioVersionId",
    "scenarioGrantId",
    "templateHash",
    "initialInputHash",
    "choicesHash",
    "binding",
    "periods",
    "reviewReceipt"
  ],
  "additionalProperties": false
}
