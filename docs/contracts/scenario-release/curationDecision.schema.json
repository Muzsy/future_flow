{
  "$id": "urn:alterward:scenario-release:curationDecision:scenario-curation-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scenarioVersionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "templateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyVersion": {
      "type": "string",
      "const": "scenario-review-1"
    },
    "reviewId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "reportHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "curationVersion": {
      "type": "string",
      "const": "scenario-curation-1"
    },
    "status": {
      "type": "string",
      "enum": [
        "scenario_reviewed",
        "changes_requested",
        "rejected"
      ]
    },
    "reasonCode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "privacy",
            "content",
            "quality",
            "meaning",
            "origin",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actorLabel": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "privacyChecked": {
      "type": "boolean",
      "const": true
    },
    "contentChecked": {
      "type": "boolean",
      "const": true
    },
    "meaningChecked": {
      "type": "boolean",
      "const": true
    },
    "qualityChecked": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "scenarioVersionId",
    "templateHash",
    "policyVersion",
    "reviewId",
    "reportHash",
    "curationVersion",
    "status",
    "reasonCode",
    "actorLabel",
    "privacyChecked",
    "contentChecked",
    "meaningChecked",
    "qualityChecked"
  ],
  "additionalProperties": false
}
