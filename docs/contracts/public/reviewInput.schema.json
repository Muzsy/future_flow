{
  "$id": "urn:alterward:public:reviewInput:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policyVersion": {
      "type": "string",
      "const": "public-review-1"
    },
    "locale": {
      "type": "string",
      "const": "en"
    },
    "fields": {
      "minItems": 3,
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^field-[1-9][0-9]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "key",
          "path",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "policyVersion",
    "locale",
    "fields"
  ],
  "additionalProperties": false
}
