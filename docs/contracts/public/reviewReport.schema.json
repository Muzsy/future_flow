{
  "$id": "urn:alterward:public:reviewReport:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "no_findings",
        "review_required",
        "unable_to_assess"
      ]
    },
    "findings": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldKey": {
            "type": "string",
            "pattern": "^field-[1-9][0-9]*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "person_name",
              "precise_location",
              "organization",
              "contact_details",
              "identifying_combination",
              "private_financial",
              "sensitive_personal",
              "third_party_sensitive",
              "harassment",
              "hate",
              "sexual",
              "violence",
              "self_harm",
              "illegal",
              "scam",
              "impersonation",
              "spam",
              "embedded_instructions",
              "language"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "remove",
              "generalize",
              "manual_review"
            ]
          }
        },
        "required": [
          "fieldKey",
          "category",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
