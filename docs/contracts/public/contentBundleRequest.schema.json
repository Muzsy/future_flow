{
  "$id": "urn:alterward:public:contentBundleRequest:public-content-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "selectedCheckpointIds": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "acknowledged": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "snapshotHash",
    "sourceRevision",
    "selectedCheckpointIds",
    "acknowledged"
  ],
  "additionalProperties": false
}
