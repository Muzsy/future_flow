{
  "$id": "urn:alterward:public:curationView:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "curationVersion": {
      "type": "string",
      "const": "text-curation-1"
    },
    "enabled": {
      "type": "boolean"
    },
    "scope": {
      "type": "string",
      "const": "text_only"
    },
    "publicationApproved": {
      "type": "boolean",
      "const": false
    },
    "curation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "text_reviewed",
                "changes_requested",
                "rejected"
              ]
            },
            "reasonCode": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "privacy",
                    "content",
                    "quality",
                    "story_consistency",
                    "other"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "status",
            "reasonCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "snapshotHash",
    "sourceRevision",
    "curationVersion",
    "enabled",
    "scope",
    "publicationApproved",
    "curation"
  ],
  "additionalProperties": false
}
