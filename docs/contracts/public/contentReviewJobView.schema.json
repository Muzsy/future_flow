{
  "$id": "urn:alterward:public:contentReviewJobView:public-content-review-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundleId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "draftId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policyVersion": {
      "type": "string",
      "const": "public-content-review-1"
    },
    "publicationApproved": {
      "type": "boolean",
      "const": false
    },
    "enabled": {
      "type": "boolean"
    },
    "job": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "report": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "no_findings",
                "review_required",
                "unable_to_assess"
              ]
            },
            "findings": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fieldKey": {
                    "type": "string",
                    "pattern": "^field-[1-9][0-9]*$"
                  },
                  "category": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "person_name",
                          "precise_location",
                          "organization",
                          "contact_details",
                          "identifying_combination",
                          "private_financial",
                          "sensitive_personal",
                          "third_party_sensitive",
                          "harassment",
                          "hate",
                          "sexual",
                          "violence",
                          "self_harm",
                          "illegal",
                          "scam",
                          "impersonation",
                          "spam",
                          "embedded_instructions",
                          "language"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "meaning_mismatch",
                          "unverifiable_structure"
                        ]
                      }
                    ]
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "remove",
                      "generalize",
                      "manual_review"
                    ]
                  }
                },
                "required": [
                  "fieldKey",
                  "category",
                  "action"
                ],
                "additionalProperties": false
              }
            },
            "policyVersion": {
              "type": "string",
              "const": "public-content-review-1"
            },
            "scope": {
              "type": "string",
              "const": "story_and_selected_checkpoints"
            },
            "contentHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "publicationApproved": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "verdict",
            "findings",
            "policyVersion",
            "scope",
            "contentHash",
            "publicationApproved"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "minItems": 3,
      "maxItems": 6000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^field-[1-9][0-9]*$"
          },
          "path": {
            "type": "string",
            "maxLength": 200,
            "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z0-9]+)*$"
          }
        },
        "required": [
          "key",
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bundleId",
    "draftId",
    "snapshotHash",
    "sourceRevision",
    "contentHash",
    "policyVersion",
    "publicationApproved",
    "enabled",
    "job",
    "report",
    "fields"
  ],
  "additionalProperties": false
}
