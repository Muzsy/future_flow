{
  "$id": "urn:alterward:public:reviewJobView:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "snapshotHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policyVersion": {
      "type": "string",
      "const": "public-review-1"
    },
    "publicationApproved": {
      "type": "boolean",
      "const": false
    },
    "enabled": {
      "type": "boolean"
    },
    "job": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "snapshotHash",
    "sourceRevision",
    "policyVersion",
    "publicationApproved",
    "enabled",
    "job"
  ],
  "additionalProperties": false
}
