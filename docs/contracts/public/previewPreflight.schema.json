{
  "$id": "urn:alterward:public:previewPreflight:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issues": {
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "codes": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "email",
                "link",
                "phone_or_identifier",
                "internal_reference",
                "private_label"
              ]
            }
          }
        },
        "required": [
          "path",
          "codes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "sourceRevision",
    "issues"
  ],
  "additionalProperties": false
}
