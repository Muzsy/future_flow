{
  "$id": "urn:alterward:public-safety:ownSafety:public-safety-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "public-safety-1"
    },
    "publishingRestricted": {
      "type": "boolean"
    },
    "restrictionRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "warnings": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^life-[a-f0-9]{32}$"
              },
              {
                "type": "string",
                "pattern": "^official-[a-f0-9]{32}$"
              }
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "personal_data",
              "harassment",
              "hate",
              "explicit_sexual_content",
              "violence",
              "illegal_content",
              "scam",
              "impersonation",
              "spam"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "warn",
              "hide",
              "remove"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "slug",
          "reason",
          "action",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "publishingRestricted",
    "restrictionRevision",
    "warnings"
  ],
  "additionalProperties": false
}
