{
  "$id": "urn:alterward:scenario-ui:ownedPublications:scenario-ui-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "scenario-ui-1"
    },
    "scenarioVersionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "publications": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "public-scenario-1"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "slug": {
            "type": "string",
            "pattern": "^scenario-[a-f0-9]{32}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "withdrawn",
              "hidden",
              "removed"
            ]
          },
          "templateHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "allowPersonalization": {
            "type": "boolean"
          },
          "officialLifeApproved": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "slug",
          "status",
          "templateHash",
          "allowPersonalization",
          "officialLifeApproved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "scenarioVersionId",
    "publications"
  ],
  "additionalProperties": false
}
