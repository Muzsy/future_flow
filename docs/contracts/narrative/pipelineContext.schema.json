{
  "$id": "urn:alterward:narrative:pipelineContext:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "const": "narrative-v1"
        },
        "promptVersions": {
          "type": "object",
          "properties": {
            "planner": {
              "type": "string",
              "enum": [
                "life_narrative_plan.v1",
                "life_narrative_plan.v2",
                "life_narrative_plan.v3"
              ]
            },
            "writer": {
              "type": "string",
              "enum": [
                "life_narrative_chapter.v1",
                "life_narrative_chapter.v2"
              ]
            },
            "fidelity": {
              "type": "string",
              "const": "life_fidelity.v4.narrative"
            },
            "editor": {
              "type": "string",
              "const": "life_narrative_editor.v1"
            }
          },
          "required": [
            "planner",
            "writer",
            "fidelity",
            "editor"
          ],
          "additionalProperties": false
        },
        "memoryVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "qualityPolicyVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "maxPhysicalRequests": {
          "type": "number",
          "const": 7
        },
        "maxContentRepairs": {
          "type": "number",
          "const": 1
        },
        "targetWords": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "const": 650
            },
            "max": {
              "type": "number",
              "const": 950
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "mode",
        "promptVersions",
        "memoryVersion",
        "qualityPolicyVersion",
        "maxPhysicalRequests",
        "maxContentRepairs",
        "targetWords"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "branchId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "baseRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "history": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "periodId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "startDate": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "endDate": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "position": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "summary": {
                "type": "string",
                "minLength": 80,
                "maxLength": 500
              },
              "salientEventIds": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "excerpt": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 1200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "periodId",
              "startDate",
              "endDate",
              "position",
              "summary",
              "salientEventIds",
              "excerpt"
            ],
            "additionalProperties": false
          }
        },
        "recentChoices": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decisionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "optionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "acceptedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "changesSummary": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "decisionId",
              "optionId",
              "acceptedAt",
              "label",
              "changesSummary"
            ],
            "additionalProperties": false
          }
        },
        "openThreads": {
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "originPeriodId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "originEventId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "goal",
                  "relationship",
                  "opportunity",
                  "conflict",
                  "motif"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 40,
                "maxLength": 300
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "progressed",
                  "resolved",
                  "dropped"
                ]
              },
              "dueByPeriodOffset": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ]
              },
              "lastTouchedPeriodId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "eventRefs": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              }
            },
            "required": [
              "id",
              "originPeriodId",
              "originEventId",
              "kind",
              "summary",
              "status",
              "dueByPeriodOffset",
              "lastTouchedPeriodId",
              "eventRefs"
            ],
            "additionalProperties": false
          }
        },
        "fictionalActors": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actorId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "introducedByEventId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "role": {
                "type": "string",
                "minLength": 20,
                "maxLength": 120
              },
              "desire": {
                "type": "string",
                "minLength": 20,
                "maxLength": 200
              },
              "resistance": {
                "type": "string",
                "minLength": 20,
                "maxLength": 200
              },
              "voiceCue": {
                "type": "string",
                "minLength": 20,
                "maxLength": 120
              },
              "lastSeenPeriodId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "actorId",
              "introducedByEventId",
              "role",
              "desire",
              "resistance",
              "voiceCue",
              "lastSeenPeriodId"
            ],
            "additionalProperties": false
          }
        },
        "recentDecisionPatterns": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "withheld": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "branchId",
        "baseRevision",
        "history",
        "recentChoices",
        "openThreads",
        "fictionalActors",
        "recentDecisionPatterns",
        "withheld"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "policy",
    "memory"
  ],
  "additionalProperties": false
}
