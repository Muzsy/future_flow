{
  "$id": "urn:alterward:publication:prepareRequest:publication-1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "binding": {
      "type": "object",
      "properties": {
        "bundleId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reviewHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyVersion": {
          "type": "string",
          "const": "public-content-review-1"
        },
        "curationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "curationVersion": {
          "type": "string",
          "const": "public-content-curation-1"
        }
      },
      "required": [
        "bundleId",
        "contentHash",
        "sourceRevision",
        "reviewId",
        "reviewHash",
        "policyVersion",
        "curationId",
        "curationVersion"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "unlisted"
          ]
        },
        "authorMode": {
          "type": "string",
          "enum": [
            "anonymous",
            "handle"
          ]
        },
        "indexable": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "visibility",
        "authorMode",
        "indexable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "binding",
    "settings"
  ],
  "additionalProperties": false
}
