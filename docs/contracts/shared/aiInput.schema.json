{
  "$id": "urn:alterward:shared:aiInput:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "locale": {
      "type": "string",
      "const": "en"
    },
    "context": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "simulationAt": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "state": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "friend_group"
                },
                "summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cohesion": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currentFocus": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "summary",
                "cohesion",
                "currentFocus"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "romantic_relationship"
                },
                "summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stage": {
                  "type": "string",
                  "enum": [
                    "dating",
                    "committed",
                    "cohabiting",
                    "engaged",
                    "married"
                  ]
                }
              },
              "required": [
                "type",
                "summary",
                "stage"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "work_project"
                },
                "summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "projectKind": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "progress": {
                  "type": "string",
                  "enum": [
                    "planned",
                    "active",
                    "completed",
                    "cancelled"
                  ]
                }
              },
              "required": [
                "type",
                "summary",
                "projectKind",
                "goal",
                "progress"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "hobby_group"
                },
                "summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "activity": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "currentFocus": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "summary",
                "activity",
                "currentFocus"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "sports_team"
                },
                "summary": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sport": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "seasonStatus": {
                  "type": "string",
                  "enum": [
                    "preseason",
                    "active",
                    "completed"
                  ]
                },
                "teamGoal": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "summary",
                "sport",
                "seasonStatus",
                "teamGoal"
              ],
              "additionalProperties": false
            }
          ]
        },
        "governance": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "individual_opt_in"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "revision",
        "simulationAt",
        "state",
        "governance"
      ],
      "additionalProperties": false
    },
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "members": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "memberId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "interactionProfile": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "ageBand": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "18_24",
                      "25_34",
                      "35_44",
                      "45_54",
                      "55_64",
                      "65_plus"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "country": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "occupationLabel": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sharedRole": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "displayName",
              "ageBand",
              "country",
              "occupationLabel",
              "sharedRole"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "memberId",
          "interactionProfile"
        ],
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "participationOptionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "optOutOptionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "rules": {
          "type": "object",
          "properties": {
            "deadlineSeconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 604800
                },
                {
                  "type": "null"
                }
              ]
            },
            "participatingOptionIds": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "quorum": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "deadlineSeconds",
            "participatingOptionIds",
            "quorum"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "participationOptionId",
        "optOutOptionId",
        "rules"
      ],
      "additionalProperties": false
    },
    "history": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "effectiveAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "summary": {
            "type": "string",
            "maxLength": 1200
          },
          "resolutionStatus": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "resolved",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "participatingMemberIds": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "eventId",
          "effectiveAt",
          "title",
          "summary",
          "resolutionStatus",
          "participatingMemberIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "locale",
    "context",
    "eventId",
    "members",
    "decision",
    "history"
  ],
  "additionalProperties": false
}
