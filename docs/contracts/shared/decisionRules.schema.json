{
  "$id": "urn:alterward:shared:decisionRules:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deadlineSeconds": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        {
          "type": "null"
        }
      ]
    },
    "participatingOptionIds": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "quorum": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "deadlineSeconds",
    "participatingOptionIds",
    "quorum"
  ],
  "additionalProperties": false
}
