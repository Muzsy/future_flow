{
  "$id": "urn:alterward:shared:reportRequest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "targetType": {
          "type": "string",
          "const": "context"
        },
        "reason": {
          "type": "string",
          "enum": [
            "harassment",
            "privacy",
            "unsafe_content",
            "spam",
            "other"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "targetType",
        "reason",
        "details"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "targetType": {
          "type": "string",
          "const": "member"
        },
        "targetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "harassment",
            "privacy",
            "unsafe_content",
            "spam",
            "other"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "targetType",
        "targetId",
        "reason",
        "details"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "targetType": {
          "type": "string",
          "const": "event"
        },
        "targetId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "harassment",
            "privacy",
            "unsafe_content",
            "spam",
            "other"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "targetType",
        "targetId",
        "reason",
        "details"
      ],
      "additionalProperties": false
    }
  ]
}
