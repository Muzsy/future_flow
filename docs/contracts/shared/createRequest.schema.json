{
  "$id": "urn:alterward:shared:createRequest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "friend_group",
        "romantic_relationship",
        "work_project",
        "hobby_group",
        "sports_team"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "branchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sharingAcknowledged": {
      "type": "boolean",
      "const": true
    },
    "interactionProfile": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ageBand": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "18_24",
                "25_34",
                "35_44",
                "45_54",
                "55_64",
                "65_plus"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "country": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "occupationLabel": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "sharedRole": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "displayName",
        "ageBand",
        "country",
        "occupationLabel",
        "sharedRole"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "title",
    "branchId",
    "revision",
    "sharingAcknowledged"
  ],
  "additionalProperties": false
}
